# Template only. Generate strong random values and encrypt the completed
# Secret with SOPS before adding secrets.yaml to kustomization.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: hermes-secrets
  namespace: hermes
type: Opaque
stringData:
  API_SERVER_KEY: REPLACE_WITH_RANDOM_HEX
  HERMES_DASHBOARD_BASIC_AUTH_USERNAME: admin
  HERMES_DASHBOARD_BASIC_AUTH_PASSWORD: REPLACE_WITH_RANDOM_PASSWORD
  HERMES_DASHBOARD_BASIC_AUTH_SECRET: REPLACE_WITH_RANDOM_HEX
  # Add the selected model provider's credentials here.
  # For Telegram, also add TELEGRAM_BOT_TOKEN and TELEGRAM_ALLOWED_USERS.
