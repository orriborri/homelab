# Template only: use a dedicated NAS account restricted to reading Bilder.
# Encrypt the completed Secret with SOPS before registering or committing it.
apiVersion: v1
kind: Secret
metadata:
  name: hermes-smb-credentials
  namespace: hermes
type: Opaque
stringData:
  username: REPLACE_WITH_NAS_USERNAME
  password: REPLACE_WITH_NAS_PASSWORD
